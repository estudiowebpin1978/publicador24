# ============================================
# PUBLICADOR24 - Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ============================================
# CONVEX (Database + Backend)
# ============================================
NEXT_PUBLIC_CONVEX_URL=https://fine-owl-595.convex.cloud

# ============================================
# AI PROVIDERS (at least one required)
# ============================================
# Provider: "openrouter" or "groq"
AI_PROVIDER=openrouter

# OpenRouter (Gemini)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-3.8-flash

# Groq (Llama 3.3 - ultra fast)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Legacy alias
AI_API_KEY=sk-or-v1-...
AI_MODEL=google/gemini-3.8-flash

# ============================================
# BUFFER (Social Media Scheduling)
# ============================================
BUFFER_API_KEY=your-real-buffer-api-key

# ============================================
# MEDIA & TTS
# ============================================
POLLINATIONS_API_KEY=sk_...
FREETTS_API_KEY=ft_...
CLOUDINARY_CLOUD_NAME=your-cloud-name

# ============================================
# SUPABASE (Database + Auth)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# APP
# ============================================
APP_URL=https://autopublicador-zeta.vercel.app
SOCIAL_MOCK_MODE=false
